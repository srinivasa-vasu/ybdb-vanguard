{
  // ── Default Codespace configuration ──────────────────────────────────────
  // This is the "Distributed SQL Basics" exercise (init-dsql).
  // To launch a different exercise, use the devcontainer picker when creating
  // a new Codespace, or run: ./launch
  "name": "YugabyteDB · DSQL Basics (default)",
  "build": {
    "dockerfile": "../.ybdb.Dockerfile",
    "context": ".."
  },
  "runArgs": ["--init"],
  "containerEnv": {
    "DATA_PATH": "ybdb",
    "ART_PATH": "init-dsql"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  // Render .vscode/tasks.json (git-ignored) with only this exercise's terminals —
  // same command as base.json "renderTasksCommand"; finishes before the editor attaches
  "onCreateCommand": "python3 .devcontainer/scripts/gen-devcontainers.py --render-tasks \"$ART_PATH\" || echo \"⚠  Terminal tasks not rendered — run: python3 .devcontainer/scripts/gen-devcontainers.py --render-tasks $ART_PATH\"",
  // Re-render (no-op when unchanged), then start a 3-node zone-aware cluster on every resume
  "postStartCommand": "python3 .devcontainer/scripts/gen-devcontainers.py --render-tasks \"$ART_PATH\" || echo \"⚠  Terminal tasks not rendered — run: python3 .devcontainer/scripts/gen-devcontainers.py --render-tasks $ART_PATH\"; bash .devcontainer/scripts/start-ybdb.sh 3",
  "customizations": {
    "vscode": {
      "settings": {
        "task.allowAutomaticTasks": "on"
      },
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "forwardPorts": [7000, 9000, 7100, 9100, 5433, 15433, 13000, 9042, 12000],
  "portsAttributes": {
    "7000":  { "label": "yb-master-web",  "onAutoForward": "ignore" },
    "9000":  { "label": "yb-tserver-web", "onAutoForward": "ignore" },
    "7100":  { "label": "yb-master-rpc",  "onAutoForward": "ignore" },
    "9100":  { "label": "yb-tserver-rpc", "onAutoForward": "ignore" },
    "5433":  { "label": "ysql",           "onAutoForward": "ignore" },
    "15433": { "label": "yugabyted-ui",   "onAutoForward": "notify" },
    "13000": { "label": "ysql-api",       "onAutoForward": "ignore" },
    "9042":  { "label": "ycql",           "onAutoForward": "ignore" },
    "12000": { "label": "ycql-api",       "onAutoForward": "ignore" }
  },
  "remoteUser": "vscode"
}
